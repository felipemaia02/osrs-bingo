# Single public origin: the SPA plus the API under /api (proxied over Railway's
# private network), so the session cookie stays first-party (SameSite=Lax).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	handle_path /api/* {
		# API_UPSTREAM, e.g. http://api.railway.internal:8000
		reverse_proxy {$API_UPSTREAM} {
			# Railway's edge overwrites X-Real-IP with the client IP on every request;
			# the API rate limits by this value.
			header_up X-Forwarded-For {http.request.header.X-Real-IP}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * /srv
		# Hashed build assets never change; everything else (the SPA shell) revalidates.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
