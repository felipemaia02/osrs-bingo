APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=osrs_bingo

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

VITE_API_URL=http://localhost:8000

# Discord OAuth2: register this exact redirect URI in your Discord application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
FRONTEND_URL=http://localhost:5173
# Comma-separated Discord user IDs that become administrators on an empty database
ADMIN_DISCORD_IDS=

# Application request safeguards (shared counters in MongoDB)
MAX_REQUEST_BODY_BYTES=65536
AUTH_REQUESTS_PER_MINUTE=20
MUTATION_REQUESTS_PER_MINUTE=120

# Screenshot storage (S3-compatible bucket). Leave empty in development to use STORAGE_LOCAL_PATH.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_LOCAL_PATH=.storage

# Maintenance mode: only logged-in admins can use the site while it's true.
MAINTENANCE_MODE=false
# Optional text shown to players, e.g. "Back at 20:00 UTC."
MAINTENANCE_MESSAGE=

# DropTracker (group export API). The key is the group's export key (group settings on
# droptracker.io); keep it only in the API environment. AstralStar is group 126.
DROPTRACKER_API_KEY=
DROPTRACKER_GROUP_ID=126
DROPTRACKER_INGEST_ENABLED=false
# Seconds between polls (minimum 30, default 300 = 5 minutes).
DROPTRACKER_POLL_SECONDS=300
DROPTRACKER_RETENTION_DAYS=30
# Phase 2: count drops toward the bingo (not used yet).
DROPTRACKER_BINGO_ENABLED=false
